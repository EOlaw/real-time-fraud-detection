# Copy to .env and replace every value. Never commit .env.
# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(48))"

# Keyed pseudonymization of card numbers during ingestion (>= 32 chars).
FRAUD_TOKENIZATION_KEY=change-me

# PostgreSQL (docker compose exposes it on localhost:5433)
POSTGRES_USER=fraud
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fraud
FRAUD_DATABASE_URL=postgresql+psycopg://fraud:change-me@localhost:5433/fraud

# API
FRAUD_JWT_SECRET=change-me
FRAUD_JWT_TTL_MINUTES=30
FRAUD_MODEL_DIR=ml/artifacts/current
FRAUD_POLICY_PATH=ml/configs/decision_policy.yaml
FRAUD_FAILURE_MODE=manual_review
FRAUD_LOG_LEVEL=INFO
